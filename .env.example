# Database Config
DATABASE_URL=postgresql://ase_user:ase_password@localhost:5432/ase_db
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=super_secret_key_change_me_in_prod

# AI Config
AI_PROVIDER=OpenAIProvider # OpenAIProvider, AnthropicProvider, LocalProvider, MockProvider
AI_MODEL=gpt-4o
AI_API_KEY=your_api_key_here

# Scanner Config
SCAN_WORKSPACE_ROOT=./workspaces
NMAP_BINARY=nmap
ZAP_URL=http://localhost:8080
SEMGREP_BINARY=semgrep
TRIVY_BINARY=trivy
GITLEAKS_BINARY=gitleaks

SCAN_TIMEOUT=3600
BUILD_TIMEOUT=1800

# Encrypted secure-share limits (encrypted payloads are stored for 24 hours by default)
SECURE_SHARE_STORAGE_DIR=./secure-shares
SECURE_SHARE_MAX_BYTES=52428800
SECURE_SHARE_RETENTION_HOURS=24
SECURE_SHARE_MAX_DOWNLOADS=5
